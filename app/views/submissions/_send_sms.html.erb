<div class="form-control">
  <% if TwilioSms.configured? %>
    <%= f.label :send_sms, for: uuid = SecureRandom.uuid, class: 'flex items-center cursor-pointer' do %>
      <%= f.check_box :send_sms, id: uuid, class: 'base-checkbox', checked: local_assigns[:checked] == true && !local_assigns.key?(:resend_sms) %>
      <span class="label"><%= local_assigns[:resend_sms] ? t('re_send_sms') : t('send_sms') %></span>
    <% end %>
  <% else %>
    <div class="alert my-4">
      <%= svg_icon('info_circle', class: 'w-6 h-6') %>
      <div>
        <p class="font-bold"><%= t('sms_not_configured') %></p>
        <p class="text-gray-700">
          <%= t('configure_sms_settings_in_order_to_send_text_messages_') %>
          <br>
          <a class="link font-medium" data-turbo-frame="_top" href="<%= settings_sms_index_path %>">
            <%= t('go_to_sms_settings') %>
          </a>
        </p>
      </div>
    </div>
  <% end %>
</div>
