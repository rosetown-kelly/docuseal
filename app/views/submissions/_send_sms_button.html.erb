<div class="mt-2 mb-1">
  <% if TwilioSms.configured? %>
    <%= button_to button_title(title: submitter.sent_at? ? t('re_send_sms') : t('send_sms'), disabled_with: t('sending')),
                  submitter_path(submitter),
                  method: :patch,
                  params: { submitter: { phone: submitter.phone }, send_sms: '1' },
                  class: 'btn btn-sm btn-primary w-full' %>
  <% else %>
    <div class="tooltip w-full" data-tip="<%= t('sms_not_configured') %>">
      <%= link_to submitter.sent_at? ? t('re_send_sms') : t('send_sms'), settings_sms_index_path, class: 'btn btn-sm btn-primary text-gray-400 w-full' %>
    </div>
  <% end %>
</div>
